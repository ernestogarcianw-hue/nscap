{
  "name": "nscap",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "nscap_events"
    }
  ]
}
